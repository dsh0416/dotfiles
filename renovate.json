{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["nix", "github-actions"],
  "nix": {
    "enabled": true
  },
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "branchConcurrentLimit": 1,
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group Nix and GitHub Actions updates",
      "matchManagers": ["nix", "github-actions"],
      "groupName": "Dependency updates",
      "groupSlug": "dependency-updates",
      "separateMajorMinor": false,
      "automerge": false
    }
  ]
}
